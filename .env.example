# The wedding this build renders when the URL carries no slug.
VITE_DEFAULT_SLUG=tema-rosewood-romance

# Override the API host the dev proxy forwards /api to (default https://api.qinvi.id).
VITE_API_PROXY_TARGET=

# 1 renders the design's own content (Aiman & Zuzie, the Johor venue, the demo accounts and
# wishes) and never calls the API -- RSVP and wishes are answered locally. Unset fetches the
# wedding named by the URL slug (or VITE_DEFAULT_SLUG).
VITE_DESIGN_MODE=
